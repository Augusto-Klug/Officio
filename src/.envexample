# Banco SQL Server. A connection string base esta em appsettings.Development.json.
Database__Password=
# Opcional: use um banco local separado ao executar --bootstrap-schema.
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=OfficioBootstrapLocal;User Id=sa;Encrypt=False;TrustServerCertificate=True

# Autenticacao JWT.
Jwt__Key=

# Armazenamento de arquivos. UseDevelopmentStorage=true requer o Azurite em execucao.
ConnectionStrings__AzureBlobStorage=UseDevelopmentStorage=true

# OCR Azure e opcional. Sem estes valores, o servico de OCR fica indisponivel.
AzureOcr__Endpoint=
AzureOcr__Key=

# Assinatura digital Autentique.
Autentique__BaseUrl=https://api.autentique.com.br/v2/graphql
Autentique__ApiToken=
Autentique__WebhookSecret=
Autentique__Sandbox=true
Autentique__OrganizationId=
Autentique__FolderId=

# URL base usada pelo sincronizador no host; a rota interna e anexada automaticamente.
# No deploy servidor-teste, o Nginx local escuta em 127.0.0.1:8080 e encaminha /api/ para a API.
# Configure o mesmo segredo aleatorio na API e no sincronizador.
# TempoReal__CallbackUrl=http://127.0.0.1:8080
# TempoReal__ChaveCompartilhada=

# Links enviados por convite e redefinicao de senha.
Acesso__FrontendBaseUrl=http://localhost:5173
Acesso__ConviteExpiracaoHoras=48
Acesso__RedefinicaoSenhaExpiracaoHoras=1

# Somente para frontend hospedado em origem diferente da API; informe a origem exata, sem caminho.
# Cors__AllowedOrigins__0=https://<seu-frontend>.azurestaticapps.net

# Em desenvolvimento, true suprime o envio e registra apenas o assunto, sem expor links ou tokens.
Email__ExporConteudoNoLog=false
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__From=
Email__Smtp__User=
Email__Smtp__Password=

# Telemetria OTLP opcional. Sem endpoint, nenhuma telemetria e exportada.
# Para usar o stack local, inicie na raiz: docker compose -f docker-compose.observabilidade.yml up -d
# Grafana: http://localhost:3000 (admin/admin na primeira inicializacao)
# Jaeger (traces): http://localhost:16686 | Prometheus (metricas): http://localhost:9090
# Alertmanager: http://localhost:9093 | Caixa de e-mail de teste Mailpit: http://localhost:8025
# O Collector recebe OTLP gRPC da API em localhost:4317 e encaminha traces/metricas.
# Alertas locais sao capturados pelo Mailpit; nao enviam e-mails para destinatarios reais.
Observabilidade__Otlp__Endpoint=
# Use 1.0 para testes locais; em producao, ajuste conforme volume/custo.
Observabilidade__TraceSampleRatio=1.0

# Bootstrap automatico local em Development. Em piloto, use --bootstrap-platform-admin uma vez.
# Habilite apenas durante o comando explicito e remova a senha depois.
# PlatformAdmin administra parceiros; Admin administra usuarios de um unico parceiro.
BootstrapUser__Enabled=false
BootstrapUser__TenantId=
BootstrapUser__TenantNome=
BootstrapUser__TenantCnpj=
BootstrapUser__TenantNomeFantasia=
BootstrapUser__TenantEmail=
BootstrapUser__Nome=
BootstrapUser__Email=
BootstrapUser__Password=
BootstrapUser__Role=PlatformAdmin
