# Copie para servidor-teste.env e preencha os valores. Nunca versionar o arquivo real.

# Banco de ensaio isolado. Use senha forte, com pelo menos 8 caracteres e maiuscula,
# minuscula, numero e simbolo.
Database__Password=TroqueEstaSenha!2026

# Chave aleatoria exclusiva deste ambiente, com pelo menos 32 caracteres.
Jwt__Key=TroquePorUmaChaveAleatoriaExclusivaDoEnsaio

# Recurso Azure Blob Storage com containers privados.
ConnectionStrings__AzureBlobStorage=DefaultEndpointsProtocol=https;AccountName=<conta>;AccountKey=<chave>;EndpointSuffix=core.windows.net

# OCR e opcional. Sem endpoint e chave, a API inicia, mas OCR fica indisponivel.
AzureOcr__Endpoint=
AzureOcr__Key=

# Autentique. Deixe Sandbox=true durante o ensaio.
Autentique__BaseUrl=https://api.autentique.com.br/v2/graphql
Autentique__ApiToken=
Autentique__WebhookSecret=
Autentique__Sandbox=true
Autentique__OrganizationId=
Autentique__FolderId=

# URL publica usada em convites e redefinicao de senha.
Acesso__FrontendBaseUrl=https://officio.app.br
# Frontend e API usam a mesma origem via proxy; CORS nao e necessario.
# Se forem separados no futuro, configure Cors__AllowedOrigins__0 com a origem exata.

# E-mail: opcional para o primeiro smoke test; necessario para validar convites reais.
Email__ExporConteudoNoLog=false
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__From=
Email__Smtp__User=
Email__Smtp__Password=

# Para ativar observabilidade no piloto, use o overlay
# docker-compose.servidor-teste.observabilidade.yml, que configura internamente
# a API para enviar logs, metricas e traces ao OpenTelemetry Collector.
# Observabilidade__TraceSampleRatio=0.1

# Preencha estes campos para provisionar o primeiro PlatformAdmin pelo comando explicito.
# Habilite BootstrapUser__Enabled=true apenas durante esse comando e depois retorne a false.
BootstrapUser__Enabled=false
BootstrapUser__TenantId=
BootstrapUser__TenantNome=
BootstrapUser__TenantCnpj=
BootstrapUser__TenantNomeFantasia=
BootstrapUser__TenantEmail=
BootstrapUser__Nome=
BootstrapUser__Email=
BootstrapUser__Password=
BootstrapUser__Role=PlatformAdmin
